# ==============================================================================
# HANZEI SOFTWARE HOUSE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# If left empty, the app runs in full offline demo/preview mode with local persistence.
# To connect to your Supabase PostgreSQL cloud database for multi-user live realtime sync:
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> API
# 3. Paste your Project URL and anon public API key below
# 4. In Vercel -> Project Settings -> Environment Variables, add these two variables as well!
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-api-key-here

